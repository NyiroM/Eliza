# -----------------------------------------------------------------------------
# ELIZA environment (copy to .env.local and adjust; never commit real secrets)
# -----------------------------------------------------------------------------
# API validation (code): job text length, PDF size/type, Ollama model tag pattern,
# preferred_location max length — see lib/validation.ts

# Base URL for the Ollama HTTP API (no trailing slash).
# Default if unset: http://127.0.0.1:11434
# Do not use 0.0.0.0 here — that is a bind address, not a valid client URL; use 127.0.0.1 or localhost.
OLLAMA_HOST=http://127.0.0.1:11434

# -----------------------------------------------------------------------------
# LAN UI access (step 1) — same Wi‑Fi / private network only
# -----------------------------------------------------------------------------
# `npm run dev` / `npm start` bind to 0.0.0.0 so phones and other PCs can open
# http://<host-lan-ip>:3000. The full Next.js backend + Ollama stay on this machine.
#
# Shared gate password for the browser login screen (/login). Leave unset to skip
# the gate (fine for localhost-only use). Strongly recommended whenever the UI is
# reachable on your LAN — traffic is still HTTP (no TLS) in step 1.
# ELIZA_GATE_PASSWORD=change-me
#
# Optional HMAC secret for the session cookie (defaults to ELIZA_GATE_PASSWORD).
# ELIZA_GATE_SECRET=
#
# Optional listen port (default 3000). Hostname is set via npm scripts (0.0.0.0).
# PORT=3000
#
# Step 2 (later): internet-wide access / HTTPS tunnel — not configured yet.

# -----------------------------------------------------------------------------
# Discovery Hub (optional server overrides — defaults in config/constants.ts)
# -----------------------------------------------------------------------------
# ELIZA_DISCOVERY_SYNC_EVAL_BATCH=
# ELIZA_DISCOVERY_QUEUE_DRAIN_BATCH=
# ELIZA_DISCOVERY_MAX_SEED_PHRASES=
# ELIZA_DISCOVERY_PLAYWRIGHT=0
# ELIZA_PROFESSION_FAST_NAV=1
# ELIZA_PROFESSION_LITE_SETTLE=
# ELIZA_PROFESSION_DETAIL_VISITS=
# ELIZA_PROFESSION_FETCH_TIMEOUT_MS=
# ELIZA_DISCOVERY_HTTP_FETCH_TIMEOUT_MS=45000
# (legacy alias: ELIZA_LINKEDIN_GUEST_FETCH_TIMEOUT_MS)

# -----------------------------------------------------------------------------
# Browser extension (apps/extension) — optional Vite variables
# -----------------------------------------------------------------------------
# VITE_ELIZA_API_URL=http://localhost:3000
